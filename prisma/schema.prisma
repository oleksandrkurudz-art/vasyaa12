// Схема даних новинного порталу.
// Документація: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Розділ сайту (Новини громади, Політика, Бізнес, Афіша, Вакансії, Оголошення, Фотогалерея)
model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  order    Int       @default(0)
  articles Article[]
  ads      Ad[]
}

// Громада (Долинська, Брошнів-Осадська, Вигодська, Перегінська, Калуська).
// Новина без громади (communityId = null) вважається загальнорайонною.
model Community {
  id         Int        @id @default(autoincrement())
  slug       String     @unique
  name       String
  order      Int        @default(0)
  articles   Article[]
  businesses Business[]
}

// Новина / стаття
model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  coverImage  String?
  // Теги через кому (SQLite не має масивів). Використовуються рушієм реклами.
  tags        String    @default("")
  status      String    @default("draft") // draft | published
  breaking    Boolean   @default(false) // термінова новина (червоний бейдж)
  views       Int       @default(0) // лічильник переглядів
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  // Громада новини; null = загальнорайонна (видно в усіх громадах).
  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([communityId])
}

// Бізнес — єдина сутність: картка в каталозі /kataloh + власник рекламних банерів.
model Business {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  description String     @default("")
  // Категорія бізнесу — slug зі списку BUSINESS_CATEGORIES (src/lib/business-categories.ts)
  category    String     @default("inshe")
  phone       String?
  address     String?
  website     String?
  photo       String?
  // Теги через кому — синергія з рушієм реклами
  tags        String     @default("")
  active      Boolean    @default(true)
  // Оплачено до (кінець дня включно); null = безстроково. Прострочені ховаються з сайту.
  paidUntil   DateTime?
  // Громада бізнесу; null = весь район
  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id])
  ads         Ad[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([active, category])
  @@index([communityId])
}

// Рекламний банер. Належить бізнесу й за замовчуванням веде на його картку.
model Ad {
  id         Int       @id @default(autoincrement())
  title      String
  imageUrl   String
  // Опційне зовнішнє посилання; порожнє = банер веде на картку бізнесу /kataloh/{slug}
  linkUrl    String    @default("")
  // Теги через кому — за ними рушій підбирає рекламу до статті
  tags       String    @default("")
  active     Boolean   @default(true)
  businessId Int
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([active])
}
